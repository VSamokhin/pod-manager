# Copy to .env and adjust. Only used on first start to create the admin account.
POD_ADMIN_USERNAME=admin
# Leave empty to get a random password printed in the logs on first start.
POD_ADMIN_PASSWORD=

# Optional
# POD_MAX_UPLOAD_MB=200
# POD_SECRET_KEY=            # default: generated once and stored in data/secret.key
# POD_SECURE_COOKIES=1       # set when served over HTTPS (e.g. behind a reverse proxy)
